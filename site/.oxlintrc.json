{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "oxc",
    "import",
    "nextjs"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "typescript/no-confusing-void-expression": "error",
    "typescript/no-unnecessary-condition": "error"
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "out/",
    ".source/"
  ]
}
